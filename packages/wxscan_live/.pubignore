# pub falls back to .gitignore only inside a git repository, and this tree is
# not one yet, so what must stay out of the archive is listed here.
.dart_tool/
build/
example/build/
example/.dart_tool/
example/ios/Pods/
example/macos/Pods/
example/android/.gradle/
example/ios/Flutter/ephemeral/
example/macos/Flutter/ephemeral/
